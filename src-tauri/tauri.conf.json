{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "个人记账",
  "mainBinaryName": "personal-ledger",
  "version": "0.1.0",
  "identifier": "com.personalledger.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "个人记账",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:ledger.db"]
    }
  }
}
